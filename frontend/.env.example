# =============================================================================
# Library Management System - Frontend Environment Configuration Example
# Copy this file to .env or set in Vercel/Netlify Environment Variables.
# NOTE: All VITE_* variables are bundled and visible to browser clients.
# NEVER put database passwords or JWT secret keys here.
# =============================================================================

# Base URL pointing to your backend API server (including /api suffix)
# Local Development: http://localhost:5000/api
# Production (Render/Railway): https://your-library-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Application Display Title
VITE_APP_TITLE=Library Management System
