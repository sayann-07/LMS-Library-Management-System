# =============================================================================
# Library Management System - Backend Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual credentials.
# =============================================================================

# Server Settings
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Database Option A: Managed Cloud Database Connection String (Recommended for Cloud)
# Supported by Aiven, PlanetScale, TiDB Cloud, Railway, Render, etc.
# Example: mysql://user:password@mysql-instance.provider.com:3306/library_db
DATABASE_URL=

# Database Option B: Discrete Parameters (Used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=library_db
DB_SSL=false
DB_CONNECTION_LIMIT=10

# Security / Authentication (JWT)
# Generate a random 64-character string for production:
JWT_SECRET=replace_with_a_long_random_secret_key_in_production
JWT_EXPIRES_IN=1d

# Allowed Frontend Origin for CORS
# In production, set this to your deployed frontend domain (e.g. https://your-library.vercel.app)
FRONTEND_URL=http://localhost:5173

# Default Admin Credentials for Seeding (Optional)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin1123
